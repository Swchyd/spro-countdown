  {
   "id": "s_msualwhmyi3v",
   "title": "[IND] PILIHANKU",
   "author": "Redo Daeng Badjie, Lewi Matheus Dethan",
   "sections": [
    {
     "key": "verse 1",
     "tag": "Verse 1",
     "lines": [
      "Kau Tuhan yang mulia",
      "turun ke dunia",
      "′Tuk tebus segala dosa",
      "Kauberi kes'lamatan",
      "beri kesempatan",
      "Kasih-Mu mengubahkan"
     ],
     "notes": []
    },
    {
     "key": "pre-chorus",
     "tag": "Pre-chorus",
     "lines": [
      "Jika kuakui semua dosaku",
      "Maka Kau adalah",
      "setia dan adil",
