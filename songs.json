  {
   "id": "s_msuasxz2kqp7",
   "title": "[IND] DOA KAMI",
   "author": "Sari Simorangkir",
   "sections": [
    {
     "key": "verse 1",
     "tag": "Verse 1",
     "lines": [
      "Syukur untuk",
      "setiap rencana-Mu",
      "Dan rancangan-Mu",
      "yang mulia",
      "Dalam satu tubuh",
      "kami bersatu",
      "Menjadi duta kerajaan-Mu"
     ],
     "notes": []
    },
    {
     "key": "pre-chorus",
     "tag": "Pre-Chorus",
     "lines": [
      "Kuucapkan berkat",
      "Atas Indonesia",
      "Biar kemuliaan Tuhan",
      "Akan nyata"
     ],
     "notes": []
    },
    {
     "key": "chorus",
     "tag": "Chorus",
     "lines": [
      "Bagi bangsa ini",
      "kami berdiri",
      "Dan membawa",
      "doa kami kepada-Mu",
      "Sesuatu yang besar",
      "pasti terjadi",
      "Dan mengubahkan",
      "negeri kami",
      "Hanya nama-Mu",
      "Tuhan ditinggikan",
      "Atas seluruh bumi"
     ],
     "notes": []
    },
    {
     "key": "verse 2",
     "tag": "Verse 2",
     "lines": [
      "Kami rindu melihat Indonesia",
      "Pulih dari semua problema",
      "Hidup dalam",
      "jalan kebenaran-Mu",
      "Pancarkan",
      "terang Kemulian-Mu"
     ],
     "notes": []
    }
