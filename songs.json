     "key": "verse",
     "tag": "Verse",
     "lines": [
      "KasihMu layakkan s’luruh hidupku",
      "Mampukanku melakukan",
      "Yang Kau inginkan",
      "Tak bisa kuterlepas",
      "Kau menggenggam tanganku",
      "Ingin lebih mengenal pribadiMu."
     ],
     "notes": []
    },
    {
     "key": "chorus",
     "tag": "Chorus",
     "lines": [
      "Kuterhubung dengan-Mu",
      "S’lalu melekat di hatiMu"
     ],
     "notes": []
    },
    {
     "key": "_1",
     "tag": "",
     "lines": [
      "FirmanMu itulah dasar hidupku",
      "Yang berdaulat atas(ku)."
     ],
     "notes": []
    }
