     "tag": "Pre-Chorus",
     "lines": [
      "Imanku berkata Tuhanku hebat",
      "Yesusku berkata",
      "Ku kuat melangkah bersama Dia."
     ],
     "notes": []
    },
    {
     "key": "chorus",
     "tag": "Chorus",
     "lines": [
      "Kumemuji, ku bersorak",
